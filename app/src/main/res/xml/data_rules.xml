<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="chats/" />
        <exclude domain="file" path="wake-model/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <!-- Saved logins are sealed with this phone's Keystore key; they can't be opened on another phone. -->
        <exclude domain="file" path="vault.json" />
    </device-transfer>
</data-extraction-rules>
