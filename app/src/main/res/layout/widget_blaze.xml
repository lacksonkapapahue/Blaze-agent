<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="BLAZE" android:textColor="#F0F0EE"
            android:textSize="11sp" android:letterSpacing="0.14" android:fontFamily="monospace" />
        <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="READY" android:textColor="#6B8CFF" android:textSize="10sp" android:letterSpacing="0.12" android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/w_last" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:text="Ask me anything, or tell me what to do on your phone."
        android:textColor="#C8C8C4" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_ask" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:background="@drawable/widget_field" android:gravity="center_vertical" android:paddingStart="18dp"
            android:text="Ask Blaze" android:textColor="#8A8A86" android:textSize="14sp" />
        <TextView android:id="@+id/w_mic" android:layout_width="56dp" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:background="@drawable/widget_mic" android:gravity="center"
            android:text="Mic" android:textColor="#FCFCFC" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>